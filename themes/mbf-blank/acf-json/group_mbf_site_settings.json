        {
            "key": "field_mbf_site_finder_message",
            "label": "How the finder works",
            "name": "",
            "type": "message",
            "instructions": "",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "message": "Shown in a hero (Beside the text › Solution finder) and in the Solution finder section. Visitors pick an option; with question 2 set they also pick a site type; then they see the recommendation and a button to the form page. The button adds <code>?need={option key}&amp;site={site key}</code>, so a form field whose default value is <code>#query_var(\"need\")</code> arrives already filled. Use the same keys as that field's option values. Without JavaScript every option is a plain link to its page.",
            "new_lines": "wpautop",
            "esc_html": 0
        },
